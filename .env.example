VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Email (Gmail - use uma Senha de App, não a senha normal)
# Gerar em: Conta Google > Segurança > Verificação em 2 etapas > Senhas de app
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App public URL (used in email links)
APP_URL=https://your-app-domain.com

# Firebase Admin SDK (for password reset link generation)
# Go to Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire JSON content as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
