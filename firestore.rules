rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Verifica se o utilizador está logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Regra Híbrida: Aceita "Modo Casal" (allowedUsers) OU "Modo Solteiro" (userId)
    function isAllowed() {
      return isAuthenticated() && (
        (resource.data.allowedUsers is list && request.auth.uid in resource.data.allowedUsers) || 
        (resource.data.userId == request.auth.uid)
      );
    }

    // Na criação, obriga a definir o array allowedUsers
    function isAllowedCreate() {
      return isAuthenticated() && (
        request.resource.data.allowedUsers is list && 
        request.auth.uid in request.resource.data.allowedUsers
      );
    }

    match /transactions/{document} {
      allow read, update, delete: if isAllowed();
      allow create: if isAllowedCreate();
    }

    match /categories/{document} {
      allow read, update, delete: if isAllowed();
      allow create: if isAllowedCreate();
    }

    match /accounts/{document} {
      allow read, update, delete: if isAllowed();
      allow create: if isAllowedCreate();
    }

    match /goals/{document} {
      allow read, update, delete: if isAllowed();
      allow create: if isAllowedCreate();
    }

    match /userRules/{document} {
      allow read, update, delete: if isAllowed();
      allow create: if isAllowedCreate();
    }

    // Bloqueia tudo o resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}