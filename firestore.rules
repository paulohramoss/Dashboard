rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica se o utilizador está logado
    function isAuthenticated() {
      return request.auth != null;
    }
    // Regra Híbrida: Aceita "Modo Casal" (allowedUsers) OU "Modo Solteiro" (userId)
    function isAllowed() {
      return isAuthenticated() && (
        (resource.data.userId == request.auth.uid) ||
        ('allowedUsers' in resource.data && resource.data.allowedUsers is list && request.auth.uid in resource.data.allowedUsers)
      );
    }

    // Regra de Criação Segura
    function isAllowedCreate() {
      return isAuthenticated() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.allowedUsers is list &&
        request.auth.uid in request.resource.data.allowedUsers
      );
    }
    // Lógica de Join (Mantive a tua, está excelente!)
    function isJoinOperation() {
      return isAuthenticated() &&
        request.method == 'update' &&
        (resource.data.allowedUsers is list) &&
        (request.auth.uid in request.resource.data.allowedUsers) &&
        // Garante que não remove ninguém existente
        (resource.data.allowedUsers.hasAll(request.resource.data.allowedUsers.removeAll([request.auth.uid]))) &&
        request.resource.data.userId == resource.data.userId;
    }
    // Planner: pessoal, apenas o dono acede
    function isPlannerOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    function isPlannerOwnerCreate() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    // --- REGRAS POR COLEÇÃO ---
    match /invites/{document} {
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow get: if true;
      allow list: if false;
      allow delete: if isAuthenticated();
    }

    // Stores partner relationships for shared finance access
    match /partnerships/{userId} {
      // Users can read their own partnership document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Owner can write; partner can write during join (they add themselves to the list)
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.uid in request.resource.data.partners
      );
    }
    match /suggestions/{document} {
      allow create: if isAuthenticated();
    }

    match /transactions/{document} {
      allow read: if isAllowed();
      allow create: if isAllowedCreate();
      allow update: if isAllowed() || isJoinOperation();
      allow delete: if isAllowed();
    }
    match /categories/{document} {
      allow read: if isAllowed();
      allow create: if isAllowedCreate();
      allow update: if isAllowed() || isJoinOperation();
      allow delete: if isAllowed();
    }
    match /accounts/{document} {
      allow read: if isAllowed();
      allow create: if isAllowedCreate();
      allow update: if isAllowed() || isJoinOperation();
      allow delete: if isAllowed();
    }
    match /goals/{document} {
      allow read: if isAllowed();
      allow create: if isAllowedCreate();
      allow update: if isAllowed() || isJoinOperation();
      allow delete: if isAllowed();
    }
    match /userRules/{document} {
      allow read: if isAllowed();
      allow create: if isAllowedCreate();
      allow update: if isAllowed() || isJoinOperation();
      allow delete: if isAllowed();
    }
    match /challenges/{document} {
      allow read: if isAllowed();
      allow create: if isAllowedCreate();
      allow update: if isAllowed() || isJoinOperation();
      allow delete: if isAllowed();
    }
    // Planner (pessoal — sem allowedUsers)
    match /plannerHabits/{document} {
      allow read: if isPlannerOwner();
      allow create: if isPlannerOwnerCreate();
      allow update: if isPlannerOwner();
      allow delete: if isPlannerOwner();
    }
    match /plannerCompletions/{document} {
      allow read: if isPlannerOwner();
      allow create: if isPlannerOwnerCreate();
      allow update: if isPlannerOwner();
      allow delete: if isPlannerOwner();
    }
    match /plannerBooks/{document} {
      allow read: if isPlannerOwner();
      allow create: if isPlannerOwnerCreate();
      allow update: if isPlannerOwner();
      allow delete: if isPlannerOwner();
    }
    match /plannerSections/{document} {
      allow read: if isPlannerOwner();
      allow create: if isPlannerOwnerCreate();
      allow update: if isPlannerOwner();
      allow delete: if isPlannerOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
